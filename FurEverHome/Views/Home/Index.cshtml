@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to FurEverHome</h1>
    <p class="lead">Helping shelter pets find their forever families.</p>
</div>

<div class="mt-4">
    <p>
        FurEverHome is a pet adoption management site. It keeps track of the
        animal shelters in our network and the pets currently available for
        adoption at each one.
    </p>
    <p>The site manages two kinds of data:</p>
    <ul>
        <li><strong>Shelters</strong> – name, city, phone number, and email.</li>
        <li><strong>Pets</strong> – name, species, breed, age, description,
            date arrived, and adoption status, each linked to the shelter
            caring for them.</li>
    </ul>
</div>
